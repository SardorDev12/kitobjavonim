# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
!.env.example
# .env.production is committed on purpose — see the comment in that file.
# It holds only EXPO_PUBLIC_* values, which are meant to be public: they are
# inlined into the client bundle regardless of where they come from. This is
# what the Plesk build server reads, since plain .env never reaches it.
!.env.production

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# build artifacts
*.zip

# Supabase CLI local state
supabase/.temp/
