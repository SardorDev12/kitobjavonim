# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard → Project Settings → Data API / API Keys).
#
# The EXPO_PUBLIC_ prefix means these are inlined into the JavaScript bundle and
# are readable by anyone using the app. That is expected: the anon key is a
# public identifier, and Row Level Security is what actually protects the data.
#
# Never put the service_role key here. It bypasses every policy in the database.
# It belongs only in Edge Function secrets (`supabase secrets set`).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Telegram sign-in (optional — skip if you deleted the Telegram button).
# The bot's @username, without the @. Public on purpose: it's the same
# username in the https://t.me/<bot> deep link signInWithTelegram opens.
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot

# The deployed web app's own URL. Used to build share links for a public
# listing (src/app/listing/[id].tsx) on every platform. Not used by Telegram
# sign-in itself anymore — that domain now lives in the telegram-bot-webhook
# Edge Function's own TELEGRAM_WEB_ORIGIN secret (see its README), which in
# practice you'll usually set to this same value.
EXPO_PUBLIC_WEB_ORIGIN=https://your-app-domain.example
