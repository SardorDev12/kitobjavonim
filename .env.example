# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard → Project Settings → Data API / API Keys).
#
# The EXPO_PUBLIC_ prefix means these are inlined into the JavaScript bundle and
# are readable by anyone using the app. That is expected: the anon key is a
# public identifier, and Row Level Security is what actually protects the data.
#
# Never put the service_role key here. It bypasses every policy in the database.
# It belongs only in Edge Function secrets (`supabase secrets set`).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
