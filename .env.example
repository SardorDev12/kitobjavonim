# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard → Project Settings → Data API / API Keys).
#
# The EXPO_PUBLIC_ prefix means these are inlined into the JavaScript bundle and
# are readable by anyone using the app. That is expected: the anon key is a
# public identifier, and Row Level Security is what actually protects the data.
#
# Never put the service_role key here. It bypasses every policy in the database.
# It belongs only in Edge Function secrets (`supabase secrets set`).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Telegram sign-in (optional — skip if you deleted the Telegram button).
# The bot's @username, without the @. Public on purpose: it has to appear in
# the login widget's page source for Telegram's script to find it.
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot

# Native only. The deployed web app's URL — the same domain registered with
# BotFather's /setdomain — since that is the page Telegram's widget script
# actually checks against. Not needed for `npm run web`.
EXPO_PUBLIC_WEB_ORIGIN=https://your-app-domain.example

# Crash reporting (optional — leave both unset and the app behaves exactly
# as if this feature didn't exist, same as GEMINI_API_KEY/scan-cover). Get a
# DSN free at sentry.io: Projects → Create Project → React Native.
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
