# Reference copy of the staging Supabase project's values — same shape as
# .env.production. Not auto-read by any build step.
#
# This is NOT served via a "Preview" environment on the production Worker —
# that was the original plan, but Cloudflare's newer Workers-Builds system
# (confirmed live, the hard way: production briefly ended up running on
# these staging credentials) has just one shared variable list per Worker,
# no separate Production/Preview scoping like classic Pages had. Staging
# instead runs as its own fully separate Worker, `kitobjavonim-staging`,
# connected to the same repo but tracking `develop` as its production
# branch, deployed via `wrangler deploy --name kitobjavonim-staging` (the
# explicit --name avoids colliding with the real Worker, since
# wrangler.jsonc's own "name" is "kitobjavonim"). This file is a saved
# reference for that Worker's variables, and for pointing a local dev
# server at staging manually if needed (cp .env.staging .env).

EXPO_PUBLIC_SUPABASE_URL=https://ahpsnvxpduaqrkvmpfck.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_nM9zD2eA5FtbkwEG_ISdnQ_W8ae4FQ3

# Same bot as production — Telegram sign-in no longer domain-locks (see
# supabase/functions/telegram-bot-webhook/README.md), so this works on
# staging with no extra setup.
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=home_library_signin_bot

# Confirmed — the kitobjavonim-staging Worker's real *.workers.dev URL.
EXPO_PUBLIC_WEB_ORIGIN=https://test.kitobjavonim.uz
