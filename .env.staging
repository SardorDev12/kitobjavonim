# Reference copy of the staging Supabase project's values — same shape as
# .env.production. Not auto-read by any build step: Cloudflare Pages builds
# directly now (no GitHub Actions step to swap env files during), so the
# real place these values need to live is Cloudflare Pages' own "Preview"
# environment variables (set separately from "Production" in its
# dashboard) — this file is a saved reference for that, and for pointing a
# local dev server at staging manually if needed (cp .env.staging .env).

EXPO_PUBLIC_SUPABASE_URL=https://ahpsnvxpduaqrkvmpfck.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_nM9zD2eA5FtbkwEG_ISdnQ_W8ae4FQ3

# Same bot as production — Telegram's own domain lock (BotFather /setdomain)
# means the widget just won't work on staging's URL until that URL is also
# registered there. Not needed for most staging use (schema/freemium/payment
# testing mainly needs email+password auth); add it later only if Telegram
# login specifically needs testing on staging.
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=home_library_signin_bot

# BEST GUESS, NOT CONFIRMED — Cloudflare's preview URL for the `develop`
# branch, inferred from the wildcard pattern shown in the dashboard
# (*-kitobjavonim.sardorfarhodogli.workers.dev). Verify this against the
# actual URL Cloudflare shows once `develop` has a real preview deployment,
# and correct it here if it's wrong — Google OAuth and the Telegram widget
# both fail silently (or redirect to the wrong place) if this doesn't match
# exactly.
EXPO_PUBLIC_WEB_ORIGIN=https://develop-kitobjavonim.sardorfarhodogli.workers.dev
